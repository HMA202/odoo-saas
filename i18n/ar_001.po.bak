#. module: saas
msgid "SaaS Manager"
msgstr "مدير SaaS"

#. module: saas
msgid "Manage SaaS plans and Odoo customer databases"
msgstr "إدارة باقات SaaS وقواعد بيانات عملاء Odoo"

#. module: saas
msgid "SaaS"
msgstr "SaaS"

#. module: saas
msgid "SaaS Clients"
msgstr "عملاء SaaS"

#. module: saas
msgid "SaaS Plans"
msgstr "باقات SaaS"

#. module: saas
msgid "SaaS Client"
msgstr "عميل SaaS"

#. module: saas
msgid "SaaS Plan"
msgstr "باقة SaaS"

#. module: saas
msgid "Name"
msgstr "الاسم"

#. module: saas
msgid "Customer Email"
msgstr "بريد العميل"

#. module: saas
msgid "Plan"
msgstr "الباقة"

#. module: saas
msgid "Database Name"
msgstr "اسم قاعدة البيانات"

#. module: saas
msgid "Subdomain"
msgstr "النطاق الفرعي"

#. module: saas
msgid "Status"
msgstr "الحالة"

#. module: saas
msgid "Database URL"
msgstr "رابط قاعدة البيانات"

#. module: saas
msgid "Last Backup Path"
msgstr "مسار آخر نسخة احتياطية"

#. module: saas
msgid "Last Backup Date"
msgstr "تاريخ آخر نسخة احتياطية"

#. module: saas
msgid "Error Message"
msgstr "رسالة الخطأ"

#. module: saas
msgid "Draft"
msgstr "مسودة"

#. module: saas
msgid "Creating"
msgstr "جاري الإنشاء"

#. module: saas
msgid "Active"
msgstr "نشط"

#. module: saas
msgid "Error"
msgstr "خطأ"

#. module: saas
msgid "Suspended"
msgstr "معلّق"

#. module: saas
msgid "Create Database"
msgstr "إنشاء قاعدة البيانات"

#. module: saas
msgid "Check Database"
msgstr "فحص قاعدة البيانات"

#. module: saas
msgid "Open Database"
msgstr "فتح قاعدة البيانات"

#. module: saas
msgid "Backup Database"
msgstr "نسخ احتياطي لقاعدة البيانات"

#. module: saas
msgid "Suspend"
msgstr "تعليق"

#. module: saas
msgid "Activate"
msgstr "تفعيل"

#. module: saas
msgid "Database name is required."
msgstr "اسم قاعدة البيانات مطلوب."

#. module: saas
msgid "Please set Template Database on the selected plan."
msgstr "يرجى تحديد قاعدة بيانات القالب في الباقة المختارة."

#. module: saas
msgid "Template database does not exist: %s"
msgstr "قاعدة بيانات القالب غير موجودة: %s"

#. module: saas
msgid "Client database already exists: %s"
msgstr "قاعدة بيانات العميل موجودة مسبقًا: %s"

#. module: saas
msgid "Database can only be created from Draft or Error state."
msgstr "يمكن إنشاء قاعدة البيانات فقط عندما تكون الحالة مسودة أو خطأ."

#. module: saas
msgid "Database created successfully: %s"
msgstr "تم إنشاء قاعدة البيانات بنجاح: %s"

#. module: saas
msgid "Create Database Failed"
msgstr "فشل إنشاء قاعدة البيانات"

#. module: saas
msgid "Database Check"
msgstr "فحص قاعدة البيانات"

#. module: saas
msgid "Database exists: %s"
msgstr "قاعدة البيانات موجودة: %s"

#. module: saas
msgid "Database does not exist."
msgstr "قاعدة البيانات غير موجودة."

#. module: saas
msgid "Database does not exist: %s"
msgstr "قاعدة البيانات غير موجودة: %s"

#. module: saas
msgid "Database Check Failed"
msgstr "فشل فحص قاعدة البيانات"

#. module: saas
msgid "Open Database"
msgstr "فتح قاعدة البيانات"

#. module: saas
msgid "Backup created successfully: %s"
msgstr "تم إنشاء النسخة الاحتياطية بنجاح: %s"

#. module: saas
msgid "Backup Failed"
msgstr "فشل النسخ الاحتياطي"

#. module: saas
msgid "Suspend Database"
msgstr "تعليق قاعدة البيانات"

#. module: saas
msgid "Only active databases can be suspended."
msgstr "يمكن تعليق قواعد البيانات النشطة فقط."

#. module: saas
msgid "Database suspended successfully: %s"
msgstr "تم تعليق قاعدة البيانات بنجاح: %s"

#. module: saas
msgid "Activate Database"
msgstr "تفعيل قاعدة البيانات"

#. module: saas
msgid "Only suspended databases can be activated."
msgstr "يمكن تفعيل قواعد البيانات المعلقة فقط."

#. module: saas
msgid "Database activated successfully: %s"
msgstr "تم تفعيل قاعدة البيانات بنجاح: %s"

#. module: saas
msgid "Database name can only contain lowercase letters, numbers, and underscores."
msgstr "يمكن أن يحتوي اسم قاعدة البيانات على أحرف إنجليزية صغيرة وأرقام وشرطة سفلية فقط."

#. module: saas
msgid "Client database name cannot start with template_."
msgstr "لا يمكن أن يبدأ اسم قاعدة بيانات العميل بـ template_."

#. module: saas
msgid "Create Database Failed"
msgstr "فشل إنشاء قاعدة البيانات"

#. module: saas
msgid "Backup Database"
msgstr "نسخ احتياطي لقاعدة البيانات"